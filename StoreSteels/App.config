<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    ERP (CHR) connection string - แยกต่างหากจาก Stock DB (GlobalConfig.ConnStr) ตามที่ร้องขอ
    ใช้อ่านข้อมูลอย่างเดียวสำหรับหน้า Packing Card เท่านั้น ไม่มีการเขียนกลับเข้าตารางนี้
  -->
  <connectionStrings>
    <add name="ErpConnectionString"
         connectionString="Server=192.168.10.10;Database=CHR;User ID=sa;Password=;TrustServerCertificate=True;Encrypt=False;ApplicationIntent=ReadOnly;" />
  </connectionStrings>
</configuration>
