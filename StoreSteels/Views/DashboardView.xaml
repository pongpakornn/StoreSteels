<Page x:Class="StoreSteels.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:gif="clr-namespace:XamlAnimatedGif;assembly=XamlAnimatedGif"
      xmlns:local="clr-namespace:StoreSteels.Helpers"
      Title="Dashboard" Background="#F4F6F9">

    <Page.Resources>

        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder" 
                                Background="Transparent" 
                                CornerRadius="8" 
                                Margin="4,2" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#EBF8FF"/>
                                <Setter Property="Foreground" Value="#2B6CB0"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718096"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="12" 
                        Background="White" 
                        Padding="4" 
                        Margin="0,0,10,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" 
                                          Color="#000000" 
                                          Opacity="0.15" 
                                          ShadowDepth="3" 
                                          Direction="315"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,10,25">
            <TextBlock Text="📊 Dashboard" FontSize="40" FontWeight="Black" Foreground="#49454F"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Margin="0,0,0,15">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" 
                            CornerRadius="16" 
                            Margin="10" 
                            Padding="20,15" 
                            MinHeight="130"
                            HorizontalAlignment="Stretch"
                            BorderBrush="#EFF2F6" 
                            BorderThickness="1"
                            MouseDown="Card_MouseDown"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CardTransform" Y="0"/>
                        </Border.RenderTransform>

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="ContextMenu" Value="{x:Null}"/>
                                <EventSetter Event="ContextMenuOpening" Handler="CustomerMenu_ContextMenuOpening"/>

                                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                                <Setter Property="ToolTipService.BetweenShowDelay" Value="500"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Title}" Value="Customer">
                                        <Setter Property="ToolTip" Value="🖱️Right lick: เพื่อเลือกดูรายการสินค้าแยกตามรายชื่อลูกค้า"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="กำลังโหลดรายชื่อลูกค้า..." IsEnabled="False"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Title}" Value="Product All">
                                        <Setter Property="ToolTip" Value="🖱️Double Click: เปิดหน้า Store ( MAX-MIN ) แสดงสินค้าทั้งหมด"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Title}" Value="Max Product">
                                        <Setter Property="ToolTip" Value="🖱️Double Click: เปิดหน้า Store ( MAX-MIN ) แสดงเฉพาะสินค้ามีค่า MAX"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Title}" Value="Min Product">
                                        <Setter Property="ToolTip" Value="🖱️Double Click: เปิดหน้า Store ( MAX-MIN ) แสดงเฉพาะสินค้ามีค่า MIN"/>
                                    </DataTrigger>

                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                         To="-8" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                         To="25" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                         To="0.3" Duration="0:0:0.25"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                         To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                         To="15" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                         To="0.15" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border.Effect>
                            <DropShadowEffect x:Name="CardShadow" BlurRadius="15" Color="#A0AEC0" Opacity="0.15" ShadowDepth="3" Direction="270"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image gif:AnimationBehavior.SourceUri="{Binding GifPath, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                       gif:AnimationBehavior.AutoStart="True"
                                       Stretch="Uniform"
                                       Margin="12"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                                <TextBlock Text="{Binding Title}" Foreground="#4A5568" FontSize="18" FontWeight="Black" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Value}" Foreground="#1A202C" FontSize="28" FontWeight="Black" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="16" Margin="10" Padding="25" BorderBrush="#EFF2F6" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#A0AEC0" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Order (Monthly Share)" FontSize="18" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,20"/>
                    <Grid Grid.Row="1">
                        <!-- แสดงทุกลูกค้าถ้าเอาเมาส์ะชี้ -->
                        <!--<lvc:PieChart Series="{Binding PieSeriesCollection}" 
                          LegendLocation="Right" 
                          Hoverable="True">
                            <lvc:PieChart.DataTooltip>
                                <lvc:DefaultTooltip BulletSize="12" 
                            Foreground="#1A202C"
                            Background="#FFFFFF"/>
                            </lvc:PieChart.DataTooltip>
                            <lvc:PieChart.ChartLegend>
                                <lvc:DefaultLegend BulletSize="12" Foreground="#4A5568"/>
                            </lvc:PieChart.ChartLegend>
                        </lvc:PieChart>-->
                        <!-- แสดงเฉพาะลูกค้าถ้าเอาเมาส์ะชี้ -->
                        <lvc:PieChart Series="{Binding PieSeriesCollection}" 
                          LegendLocation="Right" 
                          Hoverable="True">

                            <lvc:PieChart.DataTooltip>
                                <lvc:DefaultTooltip SelectionMode="OnlySender" 
                            BulletSize="12" 
                            Background="#F8FAFC" 
                            BorderBrush="#E2E8F0" 
                            BorderThickness="1"
                            Foreground="#1A202C">
                                    <lvc:DefaultTooltip.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" Margin="5">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#1A202C" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Point.AsItem.Label}" FontSize="12" Foreground="#4A5568"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </lvc:DefaultTooltip.ContentTemplate>
                                </lvc:DefaultTooltip>
                            </lvc:PieChart.DataTooltip>

                            <lvc:PieChart.ChartLegend>
                                <lvc:DefaultLegend BulletSize="12" Foreground="#4A5568"/>
                            </lvc:PieChart.ChartLegend>
                        </lvc:PieChart>
                    </Grid>
                </Grid>
            </Border>

            <!--<Border Grid.Column="1" Background="White" CornerRadius="16" Margin="10" Padding="25" BorderBrush="#EFF2F6" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#A0AEC0" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Forecast &amp; Order" FontSize="18" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,20"/>
                    <Grid Grid.Row="1">
                        <lvc:CartesianChart Series="{Binding BarSeriesCollection}" LegendLocation="Top">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Months" Labels="{Binding ChartLabels}" Foreground="#718096">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" IsEnabled="False"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Amount" LabelFormatter="{Binding ValuesFormatter}" Foreground="#718096"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Grid>
            </Border>-->
            <Border Grid.Column="1" Background="White" CornerRadius="16" Margin="10" Padding="25" BorderBrush="#EFF2F6" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#A0AEC0" Opacity="0.12" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Forecast, Order &amp; Delivery" FontSize="18" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,20"/>
                    <Grid Grid.Row="1">
                        <lvc:CartesianChart Series="{Binding BarSeriesCollection}" LegendLocation="Top">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis Title="Months" Labels="{Binding ChartLabels}" Foreground="#718096">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator Step="1" IsEnabled="False"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis Title="Amount" LabelFormatter="{Binding ValuesFormatter}" Foreground="#718096" MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>