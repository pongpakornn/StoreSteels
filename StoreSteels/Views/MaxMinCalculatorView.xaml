<Page x:Class="StoreSteels.Views.MaxMinCalculatorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Max-Min Forecast &amp; Configuration Control" Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="MainPurple" Color="#49454F"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#6750A4"/>
        <SolidColorBrush x:Key="ResultGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="ExcelOrange" Color="#D84315"/>
        <SolidColorBrush x:Key="ExcelBlue" Color="#1565C0"/>
        <SolidColorBrush x:Key="ActionBlue" Color="#1976D2"/>
        <SolidColorBrush x:Key="DeepDark" Color="#1A1C1E"/>
        <SolidColorBrush x:Key="CyberPurple" Color="#6750A4"/>
        <SolidColorBrush x:Key="CyberPink" Color="#D0BCFF"/>

        <Style x:Key="CyberButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CyberPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="12" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="buttonScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,0,0,5">
                            <Expander.Header>
                                <Border Background="#F3E5F5" CornerRadius="5" Height="38" Margin="-5,0,-5,0" BorderBrush="{StaticResource MainPurple}" BorderThickness="2,0,0,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                            <TextBlock Text="👥 CUSTOMER GROUP : " FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="14"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="15" Margin="5,0,0,0"/>
                                            <Border Background="{StaticResource MainPurple}" CornerRadius="12" Padding="12,6" Margin="15,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} รายการ'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Expander.Header>
                            <ItemsPresenter Margin="0,5,0,5" />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Margin="4,2" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EBF8FF"/>
                                <Setter Property="Foreground" Value="#2B6CB0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#6750A4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CyberComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          BorderBrush="#E0E0E0" 
                                          BorderThickness="1.5" 
                                          Background="{TemplateBinding Background}"
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Fill="#757575" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="White" CornerRadius="12" BorderThickness="0" Margin="0,4,10,10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.15" ShadowDepth="3" Direction="315"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CyberInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#E0E0E0" BorderThickness="1.5">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Foreground="#AAA" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPurple}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AnimatedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shadow" Background="Black" Opacity="0" CornerRadius="12" Margin="1,2,-1,-2"/>
                            <Border x:Name="btnBorder" CornerRadius="12" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shadow" Property="Opacity" Value="0.12"/>
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridActionButton" TargetType="Button" BasedOn="{StaticResource AnimatedButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Border Background="White" CornerRadius="25" Padding="30" Margin="20" BorderBrush="#F0F0F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="MAX-MIN CONFIGURATION &amp; AUTO CALCULATOR" FontSize="22" FontWeight="Black" Foreground="{StaticResource MainPurple}"/>
                    <TextBlock Text="ระบบกำหนดและตั้งค่าจำนวนวันปลอดภัยในการคำนวณคลังสินค้าแยกกลุ่มลูกค้า" FontSize="12" Foreground="#757575" Margin="2,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📥 IMPORT SET MAX MIN" Command="{Binding ImportSetMaxMinCommand}" Style="{StaticResource AnimatedButton}" Background="{StaticResource MainPurple}" Width="180" Height="42" Margin="0"/>
                    <Button Content="📊 IMPORT FORECAST &amp; ORDER" Command="{Binding ImportForecastOrderCommand}" Style="{StaticResource AnimatedButton}" Background="{StaticResource MainPurple}" Width="220" Height="42" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="6">
                    <TextBlock Text="CUSTOMER" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding CustomerList}" SelectedItem="{Binding SelectedCustomer}" Style="{StaticResource CyberComboBox}"  FontSize="13" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6">
                    <TextBlock Text="PART A" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding PartACodeList}" SelectedItem="{Binding SelectedPartACode}" Style="{StaticResource CyberComboBox}"  FontSize="13" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="6">
                    <TextBlock Text="PART NO" FontWeight="UltraBold" Foreground="#757575" Margin="5,0,0,6" FontSize="13"/>
                    <TextBox Text="{Binding PartNo}" IsReadOnly="True" Style="{StaticResource CyberInput}" Background="#F1F1F1"  FontSize="13" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="6">
                    <TextBlock Text="PRODUCT NAME" FontWeight="UltraBold" Foreground="#757575" Margin="5,0,0,6" FontSize="13"/>
                    <TextBox Text="{Binding PartName}" IsReadOnly="True" Style="{StaticResource CyberInput}" Background="#F1F1F1"  FontSize="13" FontWeight="Bold"/>
                </StackPanel>

                <Grid Grid.Column="4" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="SET MAX(DAYS)" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="12"/>
                        <TextBox Text="{Binding MaxDays, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnlyMode}" Style="{StaticResource CyberInput}" Tag="3"  FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="SET MIN(DAYS)" FontWeight="UltraBold" Foreground="{StaticResource AccentPurple}" Margin="5,0,0,6" FontSize="12"/>
                        <TextBox Text="{Binding MinDays, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnlyMode}" Style="{StaticResource CyberInput}" Tag="1"  FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                    
                </Grid>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,6,5">
                    <Button Content="CLEAR" Command="{Binding ClearCommand}" Style="{StaticResource AnimatedButton}" Background="{StaticResource MainPurple}" Width="80" Height="42" Margin="0,0,5,0"/>
                    <Button Content="💾 SAVE TO CONFIG" Command="{Binding UpdateMasterCommand}" IsEnabled="{Binding IsEditingMode}" Style="{StaticResource AnimatedButton}" Background="{StaticResource MainPurple}" Width="158" Height="42"/>
                </StackPanel>
            </Grid>

            <!--<UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,15">
                <Border Background="#F3E5F5" CornerRadius="15" Margin="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="CALCULATED MIN RESULT (BOX)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                        <TextBlock Text="{Binding CalculatedMinBox, StringFormat=N0}" FontSize="40" FontWeight="Black" Foreground="{StaticResource AccentPurple}" Margin="0,2,0,2"/>
                        <TextBlock Text="สูตร: Ceiling(((Order / Workday) * Min Days) / PackSize)" FontSize="10" Foreground="#888" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <Border Background="#E8F5E9" CornerRadius="15" Margin="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="CALCULATED MAX RESULT (BOX)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ResultGreen}"/>
                        <TextBlock Text="{Binding CalculatedMaxBox, StringFormat=N0}" FontSize="40" FontWeight="Black" Foreground="{StaticResource ResultGreen}" Margin="0,2,0,2"/>
                        <TextBlock Text="สูตร: Ceiling(((Order / Workday) * Max Days) / PackSize)" FontSize="10" Foreground="#888" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </UniformGrid>-->

            <Grid Grid.Row="3" Margin="6,5,6,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource CyberInput}" Tag="ค้นหา Part Code หรือ Part Name ในรายการ Preview..." Height="45" FontSize="13" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                <Button Grid.Column="1" Width="130" Height="45" Margin="10,0,0,0" Command="{Binding SearchCommand}" Background="{StaticResource MainPurple}" Style="{StaticResource AnimatedButton}">
                    <TextBlock Text="SEARCH" FontWeight="Bold" VerticalAlignment="Center" Foreground="White" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <DataGrid x:Name="dgPreview" Grid.Row="4" 
                      ItemsSource="{Binding PreviewList}" 
                      AutoGenerateColumns="False" 
                      Background="Transparent" 
                      BorderThickness="0" 
                      RowHeight="50" 
                      FontSize="13"
                      FontWeight="Bold"
                      IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#F5F5F5" 
                      HeadersVisibility="Column"
                      SelectionUnit="FullRow"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource CategoryHeaderStyle}"/>
                </DataGrid.GroupStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="ExtraBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Resources>
                    <Style x:Key="CenterGridText" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>


                    <DataGridTextColumn Header="PART A" Binding="{Binding PartACode}" Width="1.2*" MinWidth="90" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="PART NO" Binding="{Binding PartNo}" Width="1.6*" MinWidth="140" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding PartName}" Width="2.8*" MinWidth="180" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="PACK SIZE" Binding="{Binding PackSize}" Width="0.9*" MinWidth="80" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="MIN (DAYS)" Binding="{Binding MinDays}" Width="1.1*" MinWidth="90" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="MAX (DAYS)" Binding="{Binding MaxDays}" Width="1.1*" MinWidth="90" ElementStyle="{StaticResource CenterGridText}"/>
                    <!--<DataGridTextColumn Header="MAX (BOX)" Binding="{Binding QtyMax, StringFormat=N0}" Width="1.1*" MinWidth="95" ElementStyle="{StaticResource CenterGridText}"/>
                    <DataGridTextColumn Header="MIN (BOX)" Binding="{Binding QtyMin, StringFormat=N0}" Width="1.1*" MinWidth="95" ElementStyle="{StaticResource CenterGridText}"/>-->
                    <DataGridTemplateColumn Header="ACTION" Width="1.8*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Content="VIEW" 
                                        Style="{StaticResource CyberButton}"
                                        Background="{StaticResource CyberPink}"
                                        Foreground="{StaticResource DeepDark}" 
                                        FontWeight="Black"
                                        FontSize="11"
                                        Height="28" 
                                        Width="55" 
                                        Margin="0,0,5,0"
                                        Command="{Binding DataContext.ViewRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>


                                    <Button Content="EDIT" 
                                        Style="{StaticResource CyberButton}"
                                        Background="{StaticResource CyberPurple}"
                                        Foreground="White"
                                        FontWeight="Black"
                                        FontSize="11"
                                        Height="28" 
                                        Width="55"
                                        Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>