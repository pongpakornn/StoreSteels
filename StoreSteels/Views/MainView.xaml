<Window x:Class="StoreSteels.Views.MainView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:StoreSteels.Converters"
            xmlns:helpers="clr-namespace:StoreSteels.Helpers"
            Title="StoreSteels" Height="800" Width="1400" 
            Background="{StaticResource BgLight}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>



        <!-- Function Sidebar : Container -->
        <Border x:Name="SidebarContainer" Grid.Column="0" Width="260" Background="{StaticResource PrimaryColor}">
            <Border.Resources>
                <Style x:Key="SidebarIconStyle" TargetType="Image">
                    <Setter Property="Width" Value="34"/>
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
                    <Setter Property="Margin" Value="-2,0,0,0"/>
                </Style>

                <Style x:Key="SidebarTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="6,5,0,0"/>
                    <Setter Property="Visibility" Value="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Style>

                <Style x:Key="DropdownStatusStyle" TargetType="Ellipse">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Margin" Value="7,0,10,0"/>
                </Style>


            </Border.Resources>


            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <Border Height="60" Background="{StaticResource PrimaryDark}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Grid Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Border Background="{StaticResource AccentColor}">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/StoreSteels.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Run Text="STORE" FontWeight="ExtraBold" Foreground="White" FontSize="18" />
                            <Run Text=" PC" FontWeight="ExtraBold" Foreground="#AAAAAA" FontSize="18"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Function Button : Dashboard -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnDashboard_Click" Margin="5,4,0,0" Visibility="{Binding CurrentUser.CanViewDashboard, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="30" Height="30" Source="/Assets/Icons/Dashboard.png" Style="{StaticResource SidebarIconStyle}"  Margin="-1,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Dashboard" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : Store ( Max - Min ) -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnStore_Click" Margin="5,4,0,0" Visibility="{Binding CurrentUser.CanViewAdminMenu, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="35" Height="32" Source="/Assets/Icons/StoreMaxMin.png" Style="{StaticResource SidebarIconStyle}"/>
                            <TextBlock Grid.Column="1" Text="Store ( Max - Min )" Style="{StaticResource SidebarTextStyle}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : Dropdown -->
                    <Expander x:Name="ExpanderScanner" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              Margin="0,5,0,0" 
                              Padding="0" 
                              HorizontalContentAlignment="Stretch"
                              Expanded="ExpanderScanner_Expanded" 
                              Collapsed="ExpanderScanner_Collapsed"
                              Visibility="{Binding CurrentUser.CanViewScannerMenu, Converter={StaticResource BoolToVis}}">

                        <!-- Function Button : Header Dropdown -->
                        <Expander.Header>
                            <Grid Height="50" HorizontalAlignment="Stretch" Margin="10,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Viewbox Grid.Column="0" Width="23" Height="23" HorizontalAlignment="Center">
                                    <Border Background="White" Width="23" Height="23">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/Icons/64down_arrowFF.png" Stretch="Uniform"/>

                                        </Border.OpacityMask>
                                    </Border>
                                </Viewbox>

                                <TextBlock Grid.Column="1" 
                                       Text="MULTI-SCANNER" Margin="20,0,0,0"
                                       Style="{StaticResource SidebarTextStyle}"
                                       Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="11" 
                                       FontWeight="ExtraBold" 
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Expander.Header>
                        <!-- End Function -->

                        <StackPanel x:Name="SubMenuStack" Height="0" Background="Transparent">

                            <!-- Function Button : ScanIn -->
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnScanIn_Click" Height="40"
                                 Visibility="{Binding CurrentUser.CanViewScanIn, Converter={StaticResource BoolToVis}}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="/Assets/Icons/DOT.png" Margin="-22,0,0,0" Style="{StaticResource SidebarIconStyle}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="MULTI-SCAN ( IN )" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" FontWeight="ExtraBold" />
                                </Grid>
                            </Button>
                            <!-- End Function -->
                            
                            <!-- Function Button : ScanOut -->
                            <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnScanOut_Click" Height="40"
                                 Visibility="{Binding CurrentUser.CanViewScanOut, Converter={StaticResource BoolToVis}}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="/Assets/Icons/DOT.png" Margin="-22,0,0,0" Style="{StaticResource SidebarIconStyle}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="MULTI-SCAN ( OUT )" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="11" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <!-- End Function -->

                        </StackPanel>
                    </Expander>
                    <!-- End Function -->

                    <!-- Function Button : Product Control -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnProductControl_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewProductControl, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Icons/registration.png" Style="{StaticResource SidebarIconStyle}" Margin="1,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Inventory Registration" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->

                    <!-- Function Button : MaxMinCalculatorl -->
                    <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnMaxMinCalculator_Click" Margin="0,5,0,0" Visibility="{Binding CurrentUser.CanViewMaxMinCalculator, Converter={StaticResource BoolToVis}}">
                            <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="/Assets/Icons/CalculatorMxMn.png" Style="{StaticResource SidebarIconStyle}" Margin="1,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Max-Min Calculator" Style="{StaticResource SidebarTextStyle}" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <!-- End Function -->
                    
                    <!-- Product Control -->
                    <!--<Button Style="{StaticResource SidebarButtonStyle}" Margin="0,5,0,0" Click="btnProductControls_Click">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="/Assets/Icons/ProductControl.png" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Margin="2,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="PRODUCT CONTROL" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="Black" Visibility="{Binding IsSidebarOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource SidebarTextStyle}"/>
                            </Grid>
                        </Button>-->

                    <!-- Function Button : PR -->
                    <!--<Button Style="{StaticResource SidebarButtonStyle}" Click="BtnPR_Click" Margin="0,5,0,0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="/Assets/Icons/PR.png" Style="{StaticResource SidebarIconStyle}" Margin="1,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="PR Management" Style="{StaticResource SidebarTextStyle}"/>
                            </Grid>
                        </Button>-->
                    <!-- End Function -->


                    <!-- Function Button : ManageUser -->
                    <!--<Button Style="{StaticResource SidebarButtonStyle}" 
                            Click="BtnManageUser_Click" 
                            Margin="0,5,0,0">
                            <Button.Visibility>
                                <Binding Path="CurrentUser.UserLevel" 
                                 Converter="{StaticResource PermissionToVisibilityConverter}" 
                                 ConverterParameter="1" />
                            </Button.Visibility>

                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" 
                                   Source="/Assets/Icons/management.png" 
                                   Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Grid.Column="1" 
                                   Text="Manage User" 
                                   Style="{StaticResource SidebarTextStyle}"/>
                            </Grid>
                        </Button>-->
                    <!-- End Function -->

                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,15">
                    <TextBlock FontSize="10" Foreground="#66FFFFFF" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="P.U."/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarOpen}" Value="True">
                                        <Setter Property="Text" Value="© 2026 Pongpakorn Urang"/>
                                        <Setter Property="FontWeight" Value="Light"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <!-- End Sidebar : Container -->


        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="20,0">
                <Grid>

                    <!-- Function : Menu Sidebar Open-Close -->
                    <Button Content="☰" Foreground="White" Background="Transparent" BorderThickness="0" 
                                FontSize="22" HorizontalAlignment="Left" Click="btnToggleSidebar_Click" Cursor="Hand"/>
                    <!-- End : Menu Sidebar Open-Close -->

                    <!-- Function TextBlock : STORE ( MAX - MIN ) -->
                    <TextBlock x:Name="txtPageTitle" Text="STORE ( MAX - MIN )" Foreground="White" 
                                   FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- End : STORE ( MAX - MIN ) -->

                    <!-- Function TextBlock : Name: Password: -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="{Binding CurrentUser.UserName}"
                                     Foreground="White" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
                            <TextBlock Text="{Binding CurrentUser.UserId, StringFormat='EmpID: {0}'}"
                                     FontWeight="Bold" Foreground="White" FontSize="11" TextAlignment="Right"/>
                        </StackPanel>

                        <!-- Function Icon : Profile -->
                        <Ellipse Width="42" Height="42" Margin="0,0,20,0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Assets/Icons/user.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- End : Profile -->


                        <!-- Function Icon : LogOut -->
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" 
                               Click="Logout_Click" VerticalAlignment="Center">
                            <Grid Width="35" Height="35" Opacity="0.7">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Border Background="White">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="/Assets/Icons/64logout_FF.png" Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                            </Grid>
                        </Button>
                        <!-- End : LogOut -->



                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="15"/>
        </Grid>
    </Grid>
</Window>