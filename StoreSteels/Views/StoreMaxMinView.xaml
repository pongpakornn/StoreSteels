        </Style>-->
        <Style x:Key="CyberGlowEllipse" TargetType="Ellipse">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="LimeGreen" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Fill" Value="Crimson">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Red" BlurRadius="15" ShadowDepth="0" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>

                    <Trigger.EnterActions>
                        <BeginStoryboard Name="RedAlertBlink">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                         From="1.0" To="0.2" 
                                         Duration="0:0:0.5" 
                                         AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="RedAlertBlink"/>
                    </Trigger.ExitActions>
                </Trigger>

                <Trigger Property="Fill" Value="#2F8247">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="DarkGreen" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="Fill" Value="LightGray">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Gray" BlurRadius="5" ShadowDepth="0" Opacity="0.4"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,0,0,5">
                            <Expander.Header>
                                <Border Background="#F3E5F5" CornerRadius="5" Height="38" Margin="-5,0,-5,0" BorderBrush="{StaticResource MainPurple}" BorderThickness="2,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Text="👥 CATEGORY : " FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="14"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" VerticalAlignment="Center" Foreground="{StaticResource MainPurple}" FontSize="15" Margin="5,0,0,0"/>
                                        <Border Background="{StaticResource MainPurple}" CornerRadius="12" Padding="12,6" Margin="15,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} รายการ'}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Expander.Header>
                            <ItemsPresenter Margin="0,5,0,5" />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Page.RenderTransform>
        <TranslateTransform x:Name="PageTransform" Y="30"/>
    </Page.RenderTransform>

    <Border Background="White" CornerRadius="25" Padding="30" Margin="20" BorderBrush="#F0F0F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📦 STORE ( MAX - MIN )" FontSize="25" FontWeight="Black" Foreground="{StaticResource MainPurple}" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="CATEGORY:" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#555" Margin="0,0,8,0"/>
                    <ComboBox x:Name="cbCategory" Width="160" Height="38" Margin="0,0,15,0"
                              Style="{StaticResource CyberComboBox}"
                              ItemContainerStyle="{StaticResource CyberComboBoxItem}"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              SelectionChanged="cbCategory_SelectionChanged"
                              VerticalContentAlignment="Center" Padding="10,0"/>

                    <Button x:Name="btnOverMax" Content="📈 MAX Stock" Width="160" Margin="0,0,8,0" Click="btnOverMax_Click"
                        Style="{StaticResource ModernHeaderButton}"
                        Background="{StaticResource MainPurple}" Foreground="#FFAB40"/>

                    <Button x:Name="btnUnderMin" Content="📉 MIN Stock" Width="160" Margin="0,0,8,0" Click="btnUnderMin_Click"
                        Style="{StaticResource ModernHeaderButton}"
                        Background="{StaticResource MainPurple}" Foreground="#FF6B6B"/>

                    <Button x:Name="btnShowAll" Content="🔄 SHOW ALL" Width="120" Click="btnShowAll_Click"
                        Style="{StaticResource ModernHeaderButton}"
                        Background="{StaticResource MainPurple}" Foreground="White"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="5,0,5,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource CyberInput}" Tag="ค้นหา Part Code หรือ Part Name..." Height="45" FontSize="14" TextChanged="txtSearch_TextChanged" KeyDown="txtSearch_KeyDown"/>

                <Button Grid.Column="1" Width="130" Height="45" Margin="10,0,0,0" Click="Search_Click" Background="{StaticResource MainPurple}" Style="{StaticResource ModernHeaderButton}"> 
                    <TextBlock Text="SEARCH" FontWeight="Bold" VerticalAlignment="Center" Foreground="White" HorizontalAlignment="Center"/>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="SHOW PRODUCTION :" FontWeight="Bold" Foreground="#373737" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>

                    <CheckBox x:Name="chkAutoScroll" Checked="chkAutoScroll_Checked" Unchecked="chkAutoScroll_Unchecked">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="border" Width="80" Height="35" Background="#373737" CornerRadius="5" Cursor="Hand">
                                    <Grid>
                                        <TextBlock x:Name="txtStatus" Text="OFF" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0" FontWeight="Bold"/>
                                        <Border x:Name="slider" Width="40" Background="#f3f3f3" Margin="2" HorizontalAlignment="Left" CornerRadius="3"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#487bdb"/>
                                        <Setter TargetName="slider" Value="Right" Property="HorizontalAlignment"/>
                                        <Setter TargetName="txtStatus" Property="Text" Value="ON"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgStore" 
              ItemsSource="{Binding GroupedProducts}" 
              Grid.Row="2" 
              AutoGenerateColumns="False" 
              Background="Transparent" 
              BorderThickness="0" 
              RowHeight="80" 
              GridLinesVisibility="Horizontal" 
              HorizontalGridLinesBrush="#F5F5F5" 
              IsReadOnly="False" 
              HeadersVisibility="Column" 
              CanUserAddRows="False" 
              CanUserDeleteRows="False" 
              FontSize="13"
              SelectionUnit="Cell"
              BeginningEdit="dgStore_BeginningEdit" 
              CellEditEnding="dgStore_CellEditEnding" 
              PreviewMouseWheel="dgStore_PreviewMouseWheel"
              ScrollViewer.ScrollChanged="dgStore_ScrollChanged"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource MainPurple}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#EEE"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StockStatus}" Value="NO_CONFIG">
                                <Setter Property="Background" Value="#F2F4F5"/>
                                <Setter Property="Foreground" Value="#ADB5BD"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource CategoryHeaderStyle}"/>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="IMAGE" Width="85" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="55" Height="55" Background="#FFFFFF" CornerRadius="6" BorderBrush="#EAEAEA" BorderThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding ProductImage}" Width="50" Height="50" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="LowQuality" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <!-- ปกติ -->
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <!-- ถ้า NO CONFIG -->
                                                    <DataTrigger Binding="{Binding StockStatus}" Value="NO_CONFIG">
                                                        <!-- ทำให้หม่น -->
                                                        <Setter Property="Opacity" Value="0.25"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PD CODE" Binding="{Binding PartCode}" IsReadOnly="True" Width="1*" MinWidth="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding PartName}" IsReadOnly="True" Width="2.4*" MinWidth="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="MAX" Width="90"
                         Binding="{Binding Max, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="MIN" Width="90"
                        Binding="{Binding Min, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- น้ำหนักคงคลัง (กก.) - เดิมแยก STOCK(BOX)/STOCK(PCS) 2 คอลัมน์ ตอนนี้เหลือค่าเดียว -->
                    <DataGridTextColumn Header="QTY (KG.)" Binding="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="False" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="REMARK" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="1.6*" MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="AcceptsReturn" Value="False"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="STATUS"
                        Width="90"
                        IsReadOnly="True">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Ellipse Style="{StaticResource CyberGlowEllipse}">

                                    <Ellipse.Fill>
                                        <Binding Path="StockStatus"
                             Converter="{StaticResource StatusToColorConverter}"/>
                                    </Ellipse.Fill>

                                </Ellipse>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>